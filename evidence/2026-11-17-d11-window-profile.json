  "limitations": [
    "Correct alignment is material. Both phases 0 and 4 are needed to see every matching run in this corpus.",
    "An all-zero interval can extend a run beyond a logical boundary. Detection is a structural fingerprint.",
    "The older b43 width comparisons do not decode the contemporary instruction fields.",
    "Literal scans do not identify lengths held in another representation or computed by code."
  ],
  "method": {
    "bcm4378_window_inputs": "File offsets and lengths from 2026-11-17-microcode-components.json with stock hashes verified",
    "control_scan": {
      "definition": "At each phase, find maximal consecutive runs of complete records with byte 7 zero. Retain runs of at least 2048 records with byte 3 nonzero in at least three fifths of the records.",
      "minimum_consecutive_records": 2048,
      "minimum_nonzero_fraction": 0.6,
      "phases_mod_8": [
        0,
