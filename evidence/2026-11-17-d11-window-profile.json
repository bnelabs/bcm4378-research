        5,
        6,
        7
      ],
      "record_bytes": 8,
      "required_nonzero_byte_index": 3,
      "required_zero_byte_index": 7,
      "scope": "Entire file",
      "summary": "Store run counts by phase for all images, both qualifying runs on each BCM4378 image, and the longest qualifying run on each control."
    },
    "file_selection": "Regular non-symlink .trx files under chip family directories in /usr/share/firmware/wifi, deduplicated by whole-file SHA-256",
    "integer_interpretation": "Unsigned little-endian 64-bit records, with zero-based byte and bit numbering",
    "literal_check": "Scan each complete BCM4378 file for the two candidate byte lengths and the two record counts as individual unsigned little-endian 32-bit literals",
    "reference_widths": {
      "b43_arch_15_bits": 51,
      "b43_arch_5_bits": 48,
      "b43_source": "https://github.com/mbuesch/b43-tools/blob/master/disassembler/main.c#L913-L936",
